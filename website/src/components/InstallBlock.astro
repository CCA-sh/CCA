<div
	class="mx-auto flex w-full max-w-md items-center justify-between gap-4 border border-neutral-800 bg-neutral-900 px-4 py-3 font-mono text-sm"
>
	<code class="text-neutral-100"><span class="text-neutral-500">$</span> pip install cca</code>
	<button
		type="button"
		class="cursor-pointer text-neutral-500 hover:text-neutral-100"
		data-copy="pip install cca"
		aria-label="Copy install command"
	>copy</button>
</div>
<script>
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
		button.addEventListener('click', async () => {
			await navigator.clipboard.writeText(button.dataset.copy ?? '');
			button.textContent = 'copied';
			setTimeout(() => (button.textContent = 'copy'), 1500);
		});
	});
</script>
